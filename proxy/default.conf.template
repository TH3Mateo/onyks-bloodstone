server {
    listen 80;
    client_max_body_size 256M;

    # Docker's embedded DNS resolver, with a short TTL, so proxy_pass re-resolves
    # container IPs on every request instead of caching a stale (dead) address
    # after a backend/frontend/svn container is recreated.
    resolver 127.0.0.11 valid=10s;

    location / {
        set $frontend_upstream http://frontend:80;
        proxy_pass $frontend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /svn/ {
        set $svn_upstream http://svn:443;
        proxy_pass $svn_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Destination $http_destination;
    }

    location /api/ {
        set $backend_upstream http://backend:8000;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The upstream must NOT carry a URI part here: with a variable in proxy_pass, a URI
    # in the variable REPLACES the request URI instead of being a prefix to substitute,
    # which would drop the file name. Without one, the original URI is passed through,
    # and the backend serves /files/ at the same path anyway.
    location /files/ {
        set $backend_files_upstream http://backend:8000;
        proxy_pass $backend_files_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}