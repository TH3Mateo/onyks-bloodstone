POSTGRES_USER=appuser
POSTGRES_PASSWORD=strongpassword
POSTGRES_DB=appdb
POSTGRES_DATA_PATH=./xyz/postgres
POSTGRES_PORT=8112

PROXY_PORT=8113
SVN_REPO_NAME=elements
SVN_DATA_PATH=./xyz/svn
SVN_PORT=8111

# Public, externally-reachable base URL for serving uploaded datasheet files
# (used to build the HelpURL column in per-category SQL views for Altium/KiCad).
PUBLIC_FILES_URL=http://your-hostname-or-ip:8113/files/


DATASHEET_UPLOAD_PATH=./xyz/datasheets

# Chalcedon installers offered in Settings, one folder per version:
#   <path>/1.2.0/Chalcedon-Setup-1.2.0.exe, <path>/1.2.0/Chalcedon-1.2.0.AppImage
CHALCEDON_RELEASES_PATH=./xyz/chalcedon
